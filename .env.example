# LiveKit server URL (e.g. ws://localhost:7880 or wss://your-livekit.example.com)
LIVEKIT_URL=ws://localhost:7880

# LiveKit API credentials
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# HTTP server port
PORT=3000

# Where to store recordings (absolute or relative to project root)
RECORDINGS_DIR=./recordings

# Recording quality presets: low | medium | high
RECORDING_QUALITY=medium

# Log level: error | warn | info | debug
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins (required). Example:
#   CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=https://your-frontend.example.com

# Comma-separated list of allowed HTTP methods, or * for all (default: *)
CORS_METHODS=*

# Comma-separated list of allowed request headers, or * for all (default: *)
CORS_HEADERS=*

# Whether to allow cookies / Authorization headers (default: true)
CORS_ALLOW_CREDENTIALS=true
